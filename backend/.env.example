# ============================================================
# Quotation & Invoice Management System - Environment Variables
# ============================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quotation_invoice_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/quotation_invoice_db

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Invoice App
SMTP_ENCRYPTION=tls

# Frontend
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=5242880

# PDF
PDF_OUTPUT_FOLDER=app/static/pdfs
